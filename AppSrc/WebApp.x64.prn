39029>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39032>>>        Case Begin
39032>>>            Case (NavigateData.eNavigateType = nfFromMain)
39034>>>                // If from main, this is a propbably a main file Select to Zoom.
39034>>>                Case Break
39035>>>
39035>>>            Case (NavigateData.eNavigateType = nfFromParent)
39038>>>                // If from parent, this is a constrained drill down.
39038>>>                Case Break
39039>>>
39039>>>            Case (NavigateData.eNavigateType = nfFromChild)
39042>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39042>>>                Case Break
39043>>>
39043>>>            Case Else // must be nfUndefined
39043>>>
39043>>>        Case End
39043>>>
39043>>>        Send SetActionButtons
39044>>>
39044>>>    End_Procedure
