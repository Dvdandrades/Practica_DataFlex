39001>>>    Procedure SetActionButtons
39004>>>        tWebNavigateData NavigateData
39004>>>        tWebNavigateData NavigateData
39004>>>        Boolean bHasRecord
39004>>>        Handle hoDD
39004>>>
39004>>>        Get Server to hoDD
39005>>>        Get GetNavigateData to NavigateData
39006>>>        Get HasRecord of hoDD to bHasRecord
39007>>>
39007>>>        // let's hide all buttons and then Show the ones we want
39007>>>        WebSet pbRender of oEditBtn to False
39008>>>        WebSet pbRender of oSaveBtn to False
39009>>>        WebSet pbRender of oCancelChangesBtn to False
39010>>>        WebSet pbRender of oDeleteBtn to False
39011>>>
39011>>>        If (NavigateData.bReadOnly) Begin
39013>>>            WebSet pbRender of oEditBtn to True
39014>>>        End
39014>>>>
39014>>>        Else Begin
39015>>>            WebSet pbRender of oSaveBtn to True
39016>>>            WebSet pbRender of oCancelChangesBtn to True
39017>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39018>>>        End
39018>>>>
39018>>>    End_Procedure
