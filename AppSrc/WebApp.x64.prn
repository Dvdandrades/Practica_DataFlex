38975>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38978>>>        Case Begin
38978>>>            Case (NavigateData.eNavigateType = nfFromMain)
38980>>>                // If from main, this is a propbably a main file Select to Zoom.
38980>>>                Case Break
38981>>>
38981>>>            Case (NavigateData.eNavigateType = nfFromParent)
38984>>>                // If from parent, this is a constrained drill down.
38984>>>                Case Break
38985>>>
38985>>>            Case (NavigateData.eNavigateType = nfFromChild)
38988>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38988>>>                Case Break
38989>>>
38989>>>            Case Else // must be nfUndefined
38989>>>
38989>>>        Case End
38989>>>
38989>>>        Send SetActionButtons
38990>>>
38990>>>    End_Procedure
38991>>>
38991>>>End_Object 
