38947>>>    Procedure SetActionButtons
38950>>>        tWebNavigateData NavigateData
38950>>>        tWebNavigateData NavigateData
38950>>>        Boolean bHasRecord
38950>>>        Handle hoDD
38950>>>
38950>>>        Get Server to hoDD
38951>>>        Get GetNavigateData to NavigateData
38952>>>        Get HasRecord of hoDD to bHasRecord
38953>>>
38953>>>        // let's hide all buttons and then Show the ones we want
38953>>>        WebSet pbRender of oEditBtn to False
38954>>>        WebSet pbRender of oSaveBtn to False
38955>>>        WebSet pbRender of oCancelChangesBtn to False
38956>>>        WebSet pbRender of oDeleteBtn to False
38957>>>
38957>>>        If (NavigateData.bReadOnly) Begin
38959>>>            WebSet pbRender of oEditBtn to True
38960>>>        End
38960>>>>
38960>>>        Else Begin
38961>>>            WebSet pbRender of oSaveBtn to True
38962>>>            WebSet pbRender of oCancelChangesBtn to True
38963>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38964>>>        End
38964>>>>
38964>>>    End_Procedure
38965>>>
38965>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38968>>>        // Close after save
38968>>>        Send NavigateClose Self
38969>>>    End_Procedure
38970>>>
38970>>>    // this will close the view after a delete
38970>>>    Procedure OnViewDeleted Handle hoDDO
38973>>>        Send NavigateClose Self
38974>>>    End_Procedure
